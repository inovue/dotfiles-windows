{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|MultiEdit|NotebookEdit|Write|Grep|Glob|mcp__graphify__.*|mcp__user-graphify__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
