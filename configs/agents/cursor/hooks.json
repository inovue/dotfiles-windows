{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "matcher": "Shell|Read|Write|Edit|Grep|ReadFile|read_file|WriteFile|write_file|EditFile|edit_file|grep_search|CallDynamicTool|call_dynamic_tool|use_mcp_tool|query_graph|get_node|get_neighbors|god_nodes|shortest_path|graph_stats|get_community|MCP:|mcp__",
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python scripts/agent_guard.py",
        "timeout": 5,
        "loop_limit": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ]
  }
}
