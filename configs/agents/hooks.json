{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|grep_search|find_by_name|grep|glob",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
