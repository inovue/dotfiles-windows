{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|grep_search|find_by_name|grep|glob|call_mcp_tool|use_mcp_tool|mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/agent_guard.py",
        "timeout": 5
      }
    ]
  }
}
