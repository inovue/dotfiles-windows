{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/agent_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}



